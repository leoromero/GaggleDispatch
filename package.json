{
  "name": "gaggledispatch",
  "version": "0.1.0",
  "description": "GaggleDispatch — federated, multi-repo AI coding orchestrator. Reads work from Linear, routes via Claude analysis of per-repo symphony.md, dispatches Archon workflow runs.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "gaggle": "./src/cli/index.ts",
    "symphony": "./src/cli/index.ts"
  },
  "scripts": {
    "start": "bun run src/cli/index.ts start",
    "cli": "bun run src/cli/index.ts",
    "build": "bun build src/cli/index.ts --target=bun --outdir=dist --minify",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.0",
    "chalk": "^5.3.0",
    "chokidar": "^3.6.0",
    "commander": "^12.1.0",
    "liquidjs": "^10.16.0",
    "proper-lockfile": "^4.1.2",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/proper-lockfile": "^4.1.4",
    "typescript": "^5.5.0"
  },
  "engines": {
    "bun": ">=1.1.0"
  }
}
